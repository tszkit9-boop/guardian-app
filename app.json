{
  "expo": {
    "name": "guardian-app",
    "slug": "guardian-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "guardianapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lok121.guardianapp"
    },
    "android": {
      "package": "com.lok121.guardianapp"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
