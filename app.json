{
  "expo": {
    "name": "guardian-app",
    "slug": "guardian-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "guardianapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.lok121.guardianapp"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "允許 $(PRODUCT_NAME) 存取相機以進行錄影存證。"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "允許 $(PRODUCT_NAME) 取用您的位置以提供守護服務。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
